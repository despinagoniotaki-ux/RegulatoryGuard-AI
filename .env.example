# RegulatoryGuard AI — environment configuration
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# IBM watsonx.ai project ID (find it in your watsonx.ai project settings)
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# IBM Cloud API key (create one at https://cloud.ibm.com/iam/apikeys)
WATSONX_API_KEY=your-ibm-cloud-api-key-here
